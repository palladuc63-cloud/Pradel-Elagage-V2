---
import { navLinks } from '../data/site.js';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length) || '/'
  : Astro.url.pathname;
const homeLink = navLinks.find((link) => link.href === '/');
const elagageLink = navLinks.find((link) => link.class === 'page-elagage');
const tpLink = navLinks.find((link) => link.class === 'page-tp');
const boisLink = navLinks.find((link) => link.class === 'page-bois');
const contactLink = navLinks.find((link) => link.class === 'page-contact');
const servicesActive = [boisLink?.href, tpLink?.href].includes(currentPath);
---

<header class="header" data-header>
  {/* Menu responsive (burger) */}
  <div class="containerMenuHeaderResponsive">
    <button id="burger-menu" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
      <span></span>
    </button>
    <a href="/" aria-label="Accueil — Pradel Elagage">
      <img src="/img/LogoTeddyV2.webp" alt="" />
    </a>
    <nav id="menu" aria-label="Navigation mobile">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a class={link.class === 'page-elagage' ? 'mobile-menu-elagage' : undefined} href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              <img class={`mobile-menu-icon ${link.class === 'page-tp' ? 'mobile-menu-icon-truck' : ''} ${link.class === 'page-accueil' ? 'mobile-menu-icon-home' : ''} ${link.class === 'page-contact' ? 'mobile-menu-icon-contact' : ''}`} src={link.class === 'page-elagage' ? '/img/arbre.png' : `/img/${link.icon}`} alt="" />
              <span>{link.class === 'page-elagage' ? 'Élagage / Abattage' : link.label}</span>
              {link.class === 'page-elagage' && (
                <svg class="mobile-menu-icon mobile-menu-icon-end" viewBox="0 0 40 62" aria-hidden="true">
                  <path d="M20 0 8 19h7L4 38h10L0 56h16v6h8v-6h16L26 38h10L25 19h7Z" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {/* Menu classique desktop */}
  <nav class="desktop-nav" aria-label="Navigation principale">
    <div class="nav-side nav-side-left">
      {homeLink && (
        <a class="nav-link" href={homeLink.href} aria-current={currentPath === homeLink.href ? 'page' : undefined}>
          <img class="nav-icon" src={`/img/${homeLink.icon}`} alt="" />
          <span>Accueil</span>
        </a>
      )}

      {elagageLink && (
        <a class="nav-link" href={elagageLink.href} aria-current={currentPath === elagageLink.href ? 'page' : undefined}>
          <img class="nav-icon" src={`/img/${elagageLink.icon}`} alt="" />
          <span>Élagage</span>
        </a>
      )}
    </div>

    <a class="brand-link" href="/" aria-label="Accueil — Pradel Elagage">
      <img class="logoHeader" src="/img/LogoTeddy.png" alt="" />
    </a>

    <div class="nav-side nav-side-right">
      <div class="services-menu" data-services>
        <button
          class="nav-link services-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="services-submenu"
          aria-current={servicesActive ? 'page' : undefined}
        >
          <span class="services-icons" aria-hidden="true">
            <img class="services-icon-wood" src="/img/IconeBois.png" alt="Bois de chauffage" />
            <img class="services-icon-digger" src="/svg/mini-pelle.svg" alt="Travaux TP" />
          </span>
          <span>Services</span>
          <svg class="menu-chevron" viewBox="0 0 12 8" aria-hidden="true">
            <path d="m1 1 5 5 5-5" />
          </svg>
        </button>
        <div id="services-submenu" class="services-submenu">
          {boisLink && (
            <a href={boisLink.href} aria-current={currentPath === boisLink.href ? 'page' : undefined}>
              <span class="submenu-wood" aria-hidden="true"></span>
              <span>Bois de chauffage</span>
            </a>
          )}
          {tpLink && (
            <a href={tpLink.href} aria-current={currentPath === tpLink.href ? 'page' : undefined}>
              <img src={`/img/${tpLink.icon}`} alt="" />
              <span>Travaux TP</span>
            </a>
          )}
        </div>
      </div>
      {contactLink && (
        <a class="nav-link" href={contactLink.href} aria-current={currentPath === contactLink.href ? 'page' : undefined}>
          <img class="nav-icon" src={`/img/${contactLink.icon}`} alt="" />
          <span>Contact</span>
        </a>
      )}
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10000;
    display: flex;
    justify-content: center;
    width: 100%;
    height: 190px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.9) 56%, rgba(255, 255, 255, 0) 100%);
    transition: height 320ms ease, background 320ms ease, box-shadow 320ms ease;
  }

  .desktop-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px minmax(0, 1fr);
    align-items: start;
    width: min(1420px, 94vw);
    height: 100%;
  }

  .nav-side {
    display: grid;
    grid-template-columns: repeat(2, minmax(150px, 1fr));
    align-items: start;
    gap: clamp(0.5rem, 2vw, 2.5rem);
    padding-top: 38px;
  }

  .nav-side-left {
    padding-right: clamp(1rem, 3vw, 3rem);
  }

  .nav-side-right {
    padding-left: clamp(1rem, 3vw, 3rem);
  }

  .nav-link {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 64px;
    padding: 0.75rem 1rem;
    border: 0;
    background: transparent;
    color: var(--colorVar3);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 220ms ease, transform 220ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current="page"] {
    color: var(--colorVar2);
  }

  .nav-icon {
    position: absolute;
    z-index: -1;
    width: 222px;
    height: 174px;
    object-fit: contain;
    opacity: 0;
    transform: translateY(6px) scale(0.86) rotate(-4deg);
    transition: opacity 240ms ease, transform 280ms ease;
  }

  .nav-link:hover .nav-icon,
  .nav-link:focus-visible .nav-icon,
  .nav-link[aria-current="page"] .nav-icon {
    opacity: 0.14;
    transform: translateY(0) scale(1) rotate(0);
  }

  .services-icons {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 430px;
    opacity: 0;
    transform: translate(-50%, -44%) scale(0.86);
    transition: opacity 240ms ease, transform 280ms ease;
  }

  .services-icons img {
    flex: none;
    object-fit: contain;
  }

  .services-icon-wood {
    width: 227px;
    height: 189px;
    margin-left: -30px;
  }

  .services-icon-digger {
    position: relative;
    left: -50px;
    width: 85px;
    height: 67px;
    margin-right: 40px;
  }

  .services-trigger:hover .services-icons,
  .services-trigger:focus-visible .services-icons,
  .services-trigger[aria-current="page"] .services-icons {
    opacity: 0.14;
    transform: translate(-50%, -50%) scale(1);
  }

  .brand-link {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 210px;
  }

  .logoHeader {
    width: 200px;
    height: auto;
    filter: drop-shadow(0 5px 8px rgba(29, 52, 58, 0.08));
    transform-origin: top center;
    transition: width 320ms ease, transform 320ms ease;
  }

  .services-menu {
    position: relative;
  }

  .services-trigger {
    cursor: pointer;
  }

  .menu-chevron {
    width: 12px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    transition: transform 220ms ease;
  }

  .services-trigger[aria-expanded="true"] .menu-chevron {
    transform: rotate(180deg);
  }

  .services-submenu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 50%;
    display: grid;
    width: max-content;
    min-width: 250px;
    padding: 0.55rem;
    border: 1px solid rgba(57, 136, 123, 0.16);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 18px 45px rgba(29, 52, 58, 0.16);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -8px);
    transition: opacity 180ms ease, transform 220ms ease;
  }

  .services-menu:hover .services-submenu,
  .services-menu:focus-within .services-submenu,
  .services-menu.is-open .services-submenu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .services-submenu a {
    display: grid;
    grid-template-columns: 70px 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-radius: 11px;
    color: var(--colorVar3);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    transition: color 180ms ease, background 180ms ease;
  }

  .services-submenu a:hover,
  .services-submenu a:focus-visible,
  .services-submenu a[aria-current="page"] {
    color: var(--colorVar2);
    background: rgba(57, 136, 123, 0.09);
  }

  .services-submenu img {
    justify-self: center;
    width: 38px;
    height: 34px;
    object-fit: contain;
  }

  .services-submenu .submenu-wood {
    justify-self: center;
    width: 57px;
    height: 26px;
    background-image: url('/img/IconeBois.png');
    background-repeat: no-repeat;
    background-position: 110% 50%;
    background-size: 102px auto;
  }

  .header.is-compact {
    height: 104px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 255, 255, 0.96) 78%, rgba(255, 255, 255, 0.82) 100%);
    box-shadow: 0 8px 28px rgba(29, 52, 58, 0.1);
  }

  .header.is-compact .desktop-nav {
    grid-template-columns: minmax(0, 1fr) 126px minmax(0, 1fr);
  }

  .header.is-compact .nav-side {
    padding-top: 15px;
  }

  .header.is-compact .nav-link {
    min-height: 55px;
    font-size: clamp(1.25rem, 1.7vw, 1.7rem);
  }

  .header.is-compact .brand-link {
    width: 126px;
  }

  .header.is-compact .logoHeader {
    width: 112px;
    transform: translateY(-2px);
  }

  .containerMenuHeaderResponsive {
    display: none;
  }

  /* Burger menu responsive */
  @media screen and (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .header,
    .header.is-compact {
      right: 0;
      z-index: 500000;
      width: 100%;
      height: auto;
      background: linear-gradient(0deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 50%);
      box-shadow: none;
    }

    .containerMenuHeaderResponsive {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
      min-height: 126px;
    }

    .containerMenuHeaderResponsive > a {
      position: absolute;
      top: 50%;
      left: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 150px;
      transform: translate(-50%, -50%);
    }

    .containerMenuHeaderResponsive > a img {
      display: block;
      width: 100%;
      height: auto;
    }

    #burger-menu {
      position: absolute;
      z-index: 2;
      top: 50%;
      right: clamp(1.25rem, 5vw, 2rem);
      width: 27px;
      height: 27px;
      margin: 0;
      padding: 0;
      overflow: visible;
      border: none;
      background: none;
      transform: translateY(-50%);
    }

    #burger-menu span,
    #burger-menu span::before,
    #burger-menu span::after {
      position: absolute;
      display: block;
      height: 4px;
      background: var(--btnColor);
      opacity: 1;
      transition: 0.3s ease-in-out;
    }

    #burger-menu span::before,
    #burger-menu span::after {
      content: "";
    }

    #burger-menu span {
      top: 13px;
      right: 0;
      width: 27px;
    }

    #burger-menu span::before {
      top: -10px;
      left: 0;
      width: 16px;
    }

    #burger-menu span::after {
      top: 10px;
      left: 0;
      width: 20px;
    }

    #burger-menu.close span {
      top: 13px;
      width: 27px;
      transform: rotate(-45deg);
    }

    #burger-menu.close span::before {
      top: 0;
      width: 27px;
      transform: rotate(90deg);
    }

    #burger-menu.close span::after {
      top: 0;
      left: 0;
      width: 0;
      opacity: 0;
      transform: rotate(90deg);
    }

    #menu {
      position: fixed;
      z-index: 1;
      top: 0;
      min-width: 100%;
      min-height: 100%;
      height: 0;
      padding-top: 20px;
      visibility: hidden;
      opacity: 0;
      text-align: center;
      transition: all 0.3s ease-in-out;
    }

    #menu.overlay {
      padding-top: 100px;
      visibility: visible;
      opacity: 1;
      background: rgba(29, 58, 63, 0.85);
    }

    #menu ul {
      padding: 0;
      list-style: none;
    }

    #menu a {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 1rem;
      min-width: min(290px, 82vw);
      margin-bottom: 24px;
      padding: 0.65rem 1rem;
      color: #fff;
      font-family: var(--font-heading);
      font-size: 32px;
      text-align: left;
    }

    #menu a[aria-current="page"] {
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.12);
    }

    #menu .mobile-menu-icon {
      width: 54px;
      height: 54px;
      flex: 0 0 54px;
      margin-right: 27px;
      object-fit: contain;
      filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.2));
      transform: scale(2);
    }

    #menu .mobile-menu-elagage {
      justify-content: center;
      gap: 0.2rem;
      width: min(360px, 96vw);
      font-size: clamp(1.35rem, 6.5vw, 1.8rem);
      white-space: nowrap;
    }

    #menu .mobile-menu-elagage .mobile-menu-icon {
      width: 48px;
      height: 48px;
      flex-basis: 48px;
      margin-right: 0;
      transform: scale(1.5);
    }

    #menu .mobile-menu-elagage .mobile-menu-icon-end {
      fill: var(--colorVar1);
      filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.2));
      transform: scale(1.25);
    }

    #menu .mobile-menu-icon-home,
    #menu .mobile-menu-icon-contact {
      margin-right: 0;
      transform: scale(2) translateX(30px);
    }

    #menu .mobile-menu-icon-truck {
      margin-right: 0;
      transform: none;
    }
  }
</style>

<script>
  function initializeHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const burgerMenu = document.getElementById('burger-menu');
    const mobileMenu = document.getElementById('menu');
    const services = document.querySelector<HTMLElement>('[data-services]');
    const servicesTrigger = services?.querySelector<HTMLButtonElement>('.services-trigger');

    if (!header || header.dataset.initialized === 'true') return;
    header.dataset.initialized = 'true';

    const updateHeader = () => header.classList.toggle('is-compact', window.scrollY > 80);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    burgerMenu?.addEventListener('click', () => {
      const expanded = burgerMenu.getAttribute('aria-expanded') === 'true';
      burgerMenu.classList.toggle('close', !expanded);
      mobileMenu?.classList.toggle('overlay', !expanded);
      burgerMenu.setAttribute('aria-expanded', String(!expanded));
      burgerMenu.setAttribute('aria-label', expanded ? 'Ouvrir le menu' : 'Fermer le menu');
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        burgerMenu?.classList.remove('close');
        mobileMenu.classList.remove('overlay');
        burgerMenu?.setAttribute('aria-expanded', 'false');
      });
    });

    servicesTrigger?.addEventListener('click', () => {
      const open = services?.classList.toggle('is-open') ?? false;
      servicesTrigger.setAttribute('aria-expanded', String(open));
    });

    services?.addEventListener('mouseenter', () => servicesTrigger?.setAttribute('aria-expanded', 'true'));
    services?.addEventListener('mouseleave', () => {
      if (!services.classList.contains('is-open')) servicesTrigger?.setAttribute('aria-expanded', 'false');
    });

    document.addEventListener('click', (event) => {
      if (services && event.target instanceof Node && !services.contains(event.target)) {
        services.classList.remove('is-open');
        servicesTrigger?.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        services?.classList.remove('is-open');
        servicesTrigger?.setAttribute('aria-expanded', 'false');
        servicesTrigger?.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', initializeHeader);
  initializeHeader();
</script>
