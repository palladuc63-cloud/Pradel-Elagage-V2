---
// Bannière de consentement cookies (repris du thème WP teddy-elagage)
---

<div id="cookie-banner-container">
  <button id="manage-cookies" class="manage-cookies" type="button" aria-haspopup="dialog">
    Gérer mes préférences
  </button>
  <p id="consent-status" class="visually-hidden" role="status" aria-live="polite"></p>
</div>

<script>
  type Consent = 'accepted' | 'refused';
  const consentKey = 'externalServicesConsent';

  function getConsent(): Consent | null {
    const value = localStorage.getItem(consentKey);
    return value === 'accepted' || value === 'refused' ? value : null;
  }

  function createCookieBanner() {
    const container = document.getElementById('cookie-banner-container');
    if (!container || document.getElementById('cookie-banner')) return;

    const dialog = document.createElement('div');
    dialog.id = 'cookie-banner';
    dialog.className = 'containerCookie';
    dialog.setAttribute('role', 'dialog');
    dialog.setAttribute('aria-modal', 'true');
    dialog.setAttribute('aria-labelledby', 'consent-title');
    dialog.setAttribute('aria-describedby', 'consent-description');
    dialog.innerHTML = `
      <div class="cookie-banner">
        <h2 id="consent-title">Vos préférences de confidentialité</h2>
        <p id="consent-description" class="cookieTxt">Google Maps est un service externe susceptible de déposer des cookies. Vous pouvez l’accepter ou le refuser. Votre choix reste modifiable à tout moment.</p>
        <div class="cookie-actions">
          <button id="accept-cookies" type="button">ACCEPTER GOOGLE MAPS</button>
          <button id="reject-cookies" type="button">REFUSER</button>
        </div>
      </div>`;
    container.append(dialog);

    const saveConsent = (value: Consent) => {
      localStorage.setItem(consentKey, value);
      dialog.remove();
      const status = document.getElementById('consent-status');
      if (status) status.textContent = value === 'accepted'
        ? 'Google Maps est autorisé.'
        : 'Google Maps reste désactivé.';
      window.dispatchEvent(new CustomEvent('external-services-consent', { detail: value }));
      document.getElementById('manage-cookies')?.focus();
    };

    dialog.querySelector('#accept-cookies')?.addEventListener('click', () => saveConsent('accepted'));
    dialog.querySelector('#reject-cookies')?.addEventListener('click', () => saveConsent('refused'));
    (dialog.querySelector('#accept-cookies') as HTMLButtonElement | null)?.focus();
  }

  function initialiseConsent() {
    document.getElementById('manage-cookies')?.addEventListener('click', createCookieBanner);
    if (!getConsent()) createCookieBanner();
  }

  document.addEventListener('astro:page-load', initialiseConsent);
</script>

<style>
  .containerCookie {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    inset: auto 0 0;
    min-height: 10vh;
    padding: 1rem;
    background-color: #b8ccb0;
    z-index: 5000;
    text-align: center;
  }

  .cookie-banner { max-width: 900px; }
  .cookie-banner h2 { font-size: 1.2rem; }
  .cookieTxt { font-family: var(--font-body); color: var(--colorVar3); }
  .cookie-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; }
  .cookie-banner button,
  .manage-cookies {
    border-radius: 10px;
    padding: 10px;
    font-family: var(--font-heading);
    color: white;
    border: none;
    background-color: var(--colorVar2);
    cursor: pointer;
  }
  .cookie-banner button:hover, .cookie-banner button:focus-visible,
  .manage-cookies:hover, .manage-cookies:focus-visible { background-color: var(--colorVar3); }
  .manage-cookies { position: fixed; right: 1rem; bottom: 1rem; z-index: 4999; font-size: .8rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 768px) {
    .cookieTxt { font-size: 1rem; }
    .cookie-actions { flex-direction: column; }
    .manage-cookies { right: .5rem; bottom: .5rem; }
  }
</style>
