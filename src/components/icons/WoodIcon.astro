---
const { label = 'Rondins de bois de chauffage' } = Astro.props;
---

<span class="service-icon anim-icon anim-wood" role="img" aria-label={label}>
  <img class="wd-top" src="/img/anim/wood-log.png" alt="" aria-hidden="true" />
  <img class="wd-bl" src="/img/anim/wood-log.png" alt="" aria-hidden="true" />
  <img class="wd-br" src="/img/anim/wood-log.png" alt="" aria-hidden="true" />
</span>

<style>
  .anim-icon { position: relative; display: block; }
  .anim-wood { aspect-ratio: 1 / 1; }

  .anim-wood img {
    position: absolute;
    width: 74%;
    height: auto;
    transform-origin: center;
  }

  .wd-top { left: 12%; bottom: 32%; z-index: 1; }
  .wd-bl  { left: -4%; bottom: 10%; z-index: 2; }
  .wd-br  { left: 26%; bottom: 13%; z-index: 3; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.service-card:hover) .wd-br,
    :global(.service-card:focus-visible) .wd-br {
      animation: wd-br-in 0.7s ease-out both;
    }

    :global(.service-card:hover) .wd-bl,
    :global(.service-card:focus-visible) .wd-bl {
      animation: wd-bl-in 0.7s ease-out 0.18s both;
    }

    :global(.service-card:hover) .wd-top,
    :global(.service-card:focus-visible) .wd-top {
      animation: wd-top-in 0.75s ease-out 0.36s both;
    }
  }

  @keyframes wd-br-in {
    0%   { transform: translate(55px, -45px) rotate(35deg); opacity: 0; }
    55%  { opacity: 1; }
    72%  { transform: translate(0, 4px) rotate(-5deg); }
    86%  { transform: translate(0, -2px) rotate(2deg); }
    100% { transform: none; opacity: 1; }
  }

  @keyframes wd-bl-in {
    0%   { transform: translate(-55px, -45px) rotate(-35deg); opacity: 0; }
    55%  { opacity: 1; }
    72%  { transform: translate(0, 4px) rotate(5deg); }
    86%  { transform: translate(0, -2px) rotate(-2deg); }
    100% { transform: none; opacity: 1; }
  }

  @keyframes wd-top-in {
    0%   { transform: translate(0, -85px) rotate(10deg); opacity: 0; }
    60%  { opacity: 1; }
    78%  { transform: translate(0, 6px) rotate(-4deg); }
    90%  { transform: translate(0, -3px) rotate(2deg); }
    100% { transform: none; opacity: 1; }
  }
</style>
