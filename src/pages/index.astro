---
import MainLayout from '../layouts/MainLayout.astro';
import Slider from '../components/Slider.astro';
import PuySeparator from '../components/PuySeparator.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { homeServices } from '../data/site.js';

const featuredServices = homeServices.filter((service) => service.title !== 'ABATTAGE');

const title = 'Élagage, abattage & bois de chauffage à Thiers (63)';
const description = "Élagage, abattage, bois de chauffage et travaux TP à Thiers et en montagne Thiernoise. 15 ans d'expérience. Devis gratuit.";
---

<MainLayout title={title} description={description} footerVariant="default">
  <Slider />

  {/* Séparateur chaîne des Puys */}
  <PuySeparator />

  <section class="services-section" aria-label="Nos principaux services">
    <div class="services-grid">
      {featuredServices.map((service) => (
        <ServiceCard
          title={service.title}
          icon={service.icon}
          iconAlt={service.iconAlt}
          description={service.description}
          link={service.link}
        />
      ))}
    </div>
  </section>
</MainLayout>

<style>
  .services-section {
    position: relative;
    margin-top: -10.8vw;
    padding: 0 max(4vw, 1.5rem) 8rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, #fff 42%, #e8eee6 100%);
  }

  .services-grid {
    position: relative;
    z-index: 130;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.6vw, 2.8rem);
    width: min(1320px, 92vw);
    margin: 0 auto;
    transform: translateY(-70px);
  }

  @media (max-width: 980px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .services-section {
      margin-top: -4rem;
      padding-bottom: 5rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
      width: min(92vw, 520px);
      transform: translateY(-30px);
    }
  }
</style>
