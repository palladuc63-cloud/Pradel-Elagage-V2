---
const { label = 'Tronçonneuse' } = Astro.props;
---

<span class="service-icon anim-icon anim-chainsaw" role="img" aria-label={label}>
  <img class="ac-body" src="/img/anim/chainsaw-body.png" alt="" aria-hidden="true" />
  <span class="ac-bar-wrap" aria-hidden="true">
    <img class="ac-bar" src="/img/anim/chainsaw-bar.png" alt="" />
    <svg class="ac-chain" viewBox="0 0 190 189">
      <path class="ac-chain-dashes" d="M96 76 L46 76 Q31 76 31 90 Q31 104 46 104 L96 104" />
      {Array.from({ length: 15 }, (_, i) => (
        <polygon class="ac-tooth" points="0,-4 9,0 0,4" style={`--i:${i}`} />
      ))}
    </svg>
  </span>
  <span class="ac-dust" aria-hidden="true"></span>
  <span class="ac-dust d2" aria-hidden="true"></span>
  <span class="ac-dust d3" aria-hidden="true"></span>
</span>

<style>
  .anim-icon { position: relative; display: block; }
  .anim-icon img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ac-bar-wrap { position: absolute; inset: 0; }

  .ac-chain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .ac-chain-dashes {
    fill: none;
    stroke: #454c4d;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 9 7;
  }

  .ac-tooth {
    fill: #454c4d;
    offset-path: path("M96 76 L46 76 Q31 76 31 90 Q31 104 46 104 L96 104");
    offset-rotate: auto 90deg;
    display: none;
  }

  @supports (offset-path: path("M0 0")) {
    .ac-tooth { display: block; }
    .ac-chain-dashes { display: none; }
  }

  .anim-chainsaw {
    transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .ac-dust {
    position: absolute;
    left: 20%;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c98a3d;
    opacity: 0;
  }

  :global(.service-card:hover) .anim-chainsaw,
  :global(.service-card:focus-visible) .anim-chainsaw {
    transform: rotate(45deg) translate(-1%, -5%);
  }

  :global(.service-card:hover) .ac-chain,
  :global(.service-card:focus-visible) .ac-chain {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.service-card:hover) .ac-chain-dashes,
    :global(.service-card:focus-visible) .ac-chain-dashes {
      animation: ac-chain-run 0.4s linear infinite;
    }

    :global(.service-card:hover) .ac-tooth,
    :global(.service-card:focus-visible) .ac-tooth {
      animation: ac-tooth-run 1s linear infinite;
      animation-delay: calc(var(--i) * -0.0667s);
    }

    :global(.service-card:hover) .ac-bar-wrap,
    :global(.service-card:focus-visible) .ac-bar-wrap {
      animation: ac-vibe 0.09s linear infinite;
    }

    :global(.service-card:hover) .ac-dust,
    :global(.service-card:focus-visible) .ac-dust {
      animation: ac-dust 0.55s ease-out infinite;
    }

    :global(.service-card:hover) .ac-dust.d2 { animation-delay: 0.18s; }
    :global(.service-card:hover) .ac-dust.d3 { animation-delay: 0.34s; }
  }

  @keyframes ac-chain-run {
    to { stroke-dashoffset: -16; }
  }

  @keyframes ac-tooth-run {
    from { offset-distance: 0%; }
    to { offset-distance: 100%; }
  }

  @keyframes ac-vibe {
    0% { transform: translate(0, 0); }
    25% { transform: translate(0.7px, 0.5px); }
    50% { transform: translate(-0.6px, 0.4px); }
    75% { transform: translate(0.5px, -0.6px); }
    100% { transform: translate(0, 0); }
  }

  @keyframes ac-dust {
    0% { transform: translate(0, 0) scale(1); opacity: 0.9; }
    100% { transform: translate(-24px, -18px) scale(0.3); opacity: 0; }
  }
</style>
