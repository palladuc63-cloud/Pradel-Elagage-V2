---
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site.js';

const title = 'Mentions légales — Pradel Élagage à Thiers (63300)';
const description = 'Mentions légales du site Pradel Élagage : éditeur, hébergement, propriété intellectuelle et responsabilité.';
const phoneHref = `tel:${site.phone.replace(/\s/g, '')}`;
---

<MainLayout title={title} description={description} noindex={true}>
  <header class="legal-hero">
    <p class="legal-kicker">Informations réglementaires</p>
    <h1>Mentions légales</h1>
    <p class="legal-lead">Éditeur du site, hébergement, propriété intellectuelle et responsabilité — tout ce que la loi vous demande de savoir sur pradel-elagage.fr.</p>
  </header>

  <article class="legal-content">
    <section>
      <h2>Éditeur du site</h2>
      <p>
        <strong>Pradel Élagage</strong><br />
        Entreprise individuelle — Teddy Pradel<br />
        {site.address.street} — {site.address.locality}<br />
        {site.address.postalCode} {site.address.city}, France<br />
        Téléphone : <a href={phoneHref}>{site.phone}</a><br />
        Email : <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </section>

    <section>
      <h2>Directeur de la publication</h2>
      <p>Teddy Pradel, en qualité d'exploitant de l'entreprise individuelle Pradel Élagage.</p>
    </section>

    <section>
      <h2>Hébergement</h2>
      <p>
        Le site et ses services associés (formulaire de contact, espace d'administration) sont hébergés par :<br />
        <strong>OVH SAS</strong> — au capital de 10 174 560 €<br />
        2 rue Kellermann, 59100 Roubaix, France<br />
        Téléphone : 10 07 — Site : <a href="https://www.ovhcloud.com" rel="noopener noreferrer">ovhcloud.com</a>
      </p>
      <p>Les données du site sont stockées sur un serveur situé en France.</p>
    </section>

    <section>
      <h2>Conception et maintenance</h2>
      <p>
        Site conçu, développé et maintenu par <strong>POINT</strong>, agence web —
        <a href="https://www.agencepoint.fr" rel="noopener noreferrer">agencepoint.fr</a>.
      </p>
    </section>

    <section>
      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble des contenus présents sur ce site — textes, images, photographies, logo, illustrations, icônes et animations —
        est la propriété exclusive de Pradel Élagage ou de ses auteurs respectifs, sauf mention contraire.
      </p>
      <p>
        Toute reproduction, représentation, modification, publication ou adaptation, totale ou partielle, de ces éléments,
        quel que soit le moyen ou le procédé utilisé, est interdite sans l'autorisation écrite préalable de Pradel Élagage.
        Toute utilisation non autorisée constitue une contrefaçon susceptible d'engager la responsabilité civile et pénale
        de son auteur (articles L.335-2 et suivants du Code de la propriété intellectuelle).
      </p>
    </section>

    <section>
      <h2>Liens externes</h2>
      <p>
        Ce site peut contenir des liens vers des sites tiers (réseaux sociaux, cartographie…).
        Pradel Élagage n'exerce aucun contrôle sur leur contenu et décline toute responsabilité quant aux informations
        qu'ils publient ou aux traitements de données qu'ils effectuent.
      </p>
    </section>

    <section>
      <h2>Responsabilité</h2>
      <p>
        Pradel Élagage s'efforce de fournir des informations exactes et à jour. Toutefois, l'éditeur ne saurait être tenu
        responsable des omissions, inexactitudes ou carences dans la mise à jour, ni des dommages directs ou indirects
        résultant de l'utilisation du site — notamment perte de données, virus, interruption de service ou erreur technique.
      </p>
      <p>
        Les informations publiées (prestations, zones d'intervention, tarifs éventuels) sont données à titre indicatif :
        seul un devis établi par Pradel Élagage fait foi.
      </p>
    </section>

    <section>
      <h2>Données personnelles</h2>
      <p>
        Le traitement des données collectées via ce site — formulaire de contact, mesure d'audience anonyme,
        carte de localisation — est détaillé dans la
        <a href="/politique-confidentialite/">politique de confidentialité</a>.
      </p>
    </section>

    <section>
      <h2>Droit applicable</h2>
      <p>
        Le présent site et ses mentions légales sont régis par le droit français. En cas de litige, et à défaut
        de résolution amiable, les tribunaux français seront seuls compétents.
      </p>
    </section>

    <p class="legal-updated">Dernière mise à jour : novembre 2025.</p>
  </article>
</MainLayout>

<style>
  .legal-hero {
    padding: clamp(9rem, 16vw, 13rem) max(6vw, 1.5rem) clamp(3rem, 6vw, 4.5rem);
    color: #fff;
    background: linear-gradient(135deg, #1d343a 0%, #315f52 55%, var(--colorVar2) 100%);
    text-align: center;
  }

  .legal-kicker {
    margin-bottom: 0.65rem;
    color: #b8ccb0;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .legal-hero h1 {
    color: #fff;
    font-size: clamp(2.8rem, 7vw, 4.8rem);
    line-height: 0.98;
  }

  .legal-lead {
    max-width: 620px;
    margin: 1.2rem auto 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .legal-content {
    width: min(860px, 90vw);
    margin: 0 auto;
    padding: 4.5rem 0 7rem;
  }

  .legal-content section {
    padding: 1.9rem 0;
    border-bottom: 1px solid rgba(57, 136, 123, 0.14);
  }

  .legal-content section:last-of-type {
    border-bottom: 0;
  }

  .legal-content h2 {
    margin-bottom: 1rem;
    color: var(--colorVar3);
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    line-height: 1.1;
  }

  .legal-content p {
    margin-top: 0.85rem;
    color: #46585a;
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .legal-content p:first-of-type {
    margin-top: 0;
  }

  .legal-content a {
    color: var(--colorVar2);
    font-weight: 800;
    text-decoration: none;
  }

  .legal-content a:hover,
  .legal-content a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-updated {
    margin-top: 2.5rem;
    color: #8a9697;
    font-size: 0.82rem;
    font-style: italic;
    text-align: center;
  }

  @media (max-width: 768px) {
    .legal-hero {
      padding-top: 8rem;
    }

    .legal-content {
      padding: 3rem 0 5rem;
    }
  }
</style>
