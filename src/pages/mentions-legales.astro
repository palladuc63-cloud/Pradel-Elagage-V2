---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site.js';

const title = 'Mentions légales — Pradel Élagage à Thiers (63300)';
const description = 'Mentions légales du site Pradel Élagage. Éditeur, hébergeur, propriété intellectuelle et responsabilité.';
---

<MainLayout title={title} description={description} footerVariant="page" noindex={true}>
  <PageHero
    image="/img/foret.png"
    imageAlt="Mentions légales Pradel Élagage"
    title="MENTIONS LÉGALES"
  />

  <article class="post">
    <div class="containerSinglePage">
      <div class="paragrapheSingle animated-element">
        <h2>Éditeur du site</h2>
        <p>
          <strong>Pradel Élagage</strong><br />
          Entreprise individuelle dirigée par Teddy Pradel<br />
          {site.address.street}<br />
          {site.address.locality}<br />
          {site.address.postalCode} {site.address.city}<br />
          Téléphone : <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br />
          Email : <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>

        <h2>Directeur de la publication</h2>
        <p>
          Teddy Pradel, en qualité d'exploitant de l'entreprise individuelle
          Pradel Élagage.
        </p>

        <h2>Hébergement</h2>
        <p>
          Le site est hébergé par <strong>OVH</strong><br />
          SAS au capital de 10 174 560 €<br />
          2 rue Kellermann<br />
          59100 Roubaix<br />
          Téléphone : 10 07
        </p>

        <h2>Propriété intellectuelle</h2>
        <p>
          L'ensemble des contenus présents sur ce site (textes, images, logos,
          graphismes) est la propriété de Pradel Élagage, sauf mention contraire.
          Toute reproduction, représentation, modification, publication, adaptation,
          totale ou partielle, des éléments du site, quel que soit le moyen ou le
          procédé utilisé, est interdite sans l'autorisation écrite préalable de
          Pradel Élagage.
        </p>

        <h2>Responsabilité</h2>
        <p>
          Pradel Élagage ne pourra être tenu responsable des dommages directs ou
          indirects résultant de l'utilisation du site, notamment d'une perte de
          données, d'un virus, d'une interruption de service ou d'une erreur
          technique.
        </p>

        <h2 id="confidentialite">Données personnelles &amp; confidentialité</h2>
        <p>
          Les informations éventuellement recueillies via le formulaire de
          contact sont utilisées uniquement pour répondre à vos demandes et ne
          sont jamais cédées à des tiers. Le site ne dépose aucun cookie de
          suivi et sa mesure d'audience est anonyme. Le détail des traitements,
          des durées de conservation et de vos droits (accès, rectification,
          suppression, opposition — loi « Informatique et Libertés » et RGPD)
          figure dans la
          <a href="/politique-confidentialite/">politique de confidentialité</a>.
        </p>
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .containerSinglePage {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-direction: row;
    transform: translateY(-44vh);
  }

  .paragrapheSingle {
    display: flex;
    flex-direction: column;
    width: 50%;
    height: auto;
    align-items: center;
    margin-right: 4vw;
  }

  .paragrapheSingle :global(h2) {
    font-family: var(--font-heading);
    font-size: 3vw;
    margin-bottom: 3vh;
    margin-top: 5vh;
    text-align: center;
  }

  .paragrapheSingle :global(p) {
    margin-bottom: 3vh;
    font-size: 1.2vw;
    text-align: center;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .containerSinglePage {
      flex-direction: column;
      transform: translateY(0);
    }

    .paragrapheSingle {
      width: 100%;
      height: auto;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .paragrapheSingle :global(h2) {
      font-size: 7vw;
    }

    .paragrapheSingle :global(p) {
      width: 100%;
      height: auto;
      font-size: 5vw;
      padding: 2vh;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('.animated-element');
    animatedElements.forEach((el) => el.classList.add('animate'));
  });
</script>
