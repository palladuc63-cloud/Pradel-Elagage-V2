---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'Actualités — Pradel Élagage à Thiers';
const description = 'Actualités de Pradel Élagage : chantiers, conseils d’élagage, saison du bois de chauffage et travaux TP autour de Thiers.';
---

<MainLayout title={title} description={description} noindex={true}>
  <section class="news-hero">
    <img src="/img/slider-elagage.webp" alt="Intervention d’élagage dans un grand arbre" fetchpriority="high" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">La vie de l’entreprise</p>
      <h1>Actualités</h1>
      <p>Chantiers marquants, conseils et saisons : suivez l’activité de Pradel Élagage autour de Thiers.</p>
    </div>
    <svg class="hero-curve" viewBox="0 0 1200 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 55c220 65 370-45 600-20s390 75 600 5v60H0Z" /></svg>
  </section>

  <section class="news-main">
    <div id="news-list" class="news-grid" aria-live="polite">
      <p class="news-status">Chargement des actualités…</p>
    </div>
    <article id="news-detail" class="news-detail" hidden>
      <a class="news-back" href="/actualites/">← Toutes les actualités</a>
      <div id="news-detail-body"></div>
    </article>
  </section>
</MainLayout>

<style>
  .news-hero{position:relative;isolation:isolate;display:flex;align-items:center;min-height:clamp(420px,50vh,560px);overflow:hidden;color:#fff}.news-hero>img,.hero-overlay{position:absolute;inset:0;z-index:-2;width:100%;height:100%}.news-hero>img{object-fit:cover;object-position:center 55%}.hero-overlay{z-index:-1;background:linear-gradient(90deg,rgba(20,43,45,.86),rgba(29,52,58,.48) 55%,rgba(29,52,58,.12))}.hero-content{width:min(1240px,88vw);margin:0 auto;padding-top:110px}.eyebrow{margin-bottom:.65rem;color:#c8ddd0;font-size:.78rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.news-hero h1{color:#fff;font-size:clamp(4rem,7vw,7rem);line-height:.85;text-shadow:0 10px 30px rgba(0,0,0,.3)}.hero-content>p:last-child{max-width:640px;margin-top:1.3rem;font-size:clamp(1.05rem,1.4vw,1.3rem);line-height:1.75}.hero-curve{position:absolute;right:0;bottom:-1px;left:0;width:100%;height:100px}.hero-curve path{fill:#fff}
  .news-main{width:min(1240px,92vw);margin:0 auto;padding:4.5rem 0 8rem}
  .news-status{grid-column:1/-1;color:#5b686b;font-size:1.05rem;text-align:center}
  .news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}
  .news-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(57,136,123,.14);border-radius:26px;background:#fff;box-shadow:0 12px 30px rgba(29,52,58,.1);transition:transform .2s ease,box-shadow .2s ease}.news-card:hover{transform:translateY(-4px);box-shadow:0 20px 44px rgba(29,52,58,.16)}
  .news-card-img{height:210px;overflow:hidden;background:#e8eee6}.news-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .3s ease}.news-card:hover .news-card-img img{transform:scale(1.04)}
  .news-card-body{display:flex;flex:1;flex-direction:column;gap:.6rem;padding:1.5rem 1.6rem 1.7rem}.news-date{color:var(--colorVar2);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.news-card h2{color:var(--colorVar3);font-size:1.6rem;line-height:1.15}.news-card p{color:#5b686b;font-size:.95rem;line-height:1.65}.news-card .news-more{margin-top:auto;padding-top:.4rem;color:var(--colorVar2);font-weight:800}
  .news-detail{max-width:820px;margin:0 auto}.news-back{display:inline-flex;margin-bottom:2rem;color:var(--colorVar2);font-weight:800}.news-detail h1{color:var(--colorVar3);font-size:clamp(2.4rem,4.4vw,3.6rem);line-height:1.02}.news-detail .news-date{margin-top:1.2rem}.news-detail-hero{margin:2rem 0;overflow:hidden;border-radius:26px}.news-detail-hero img{width:100%;max-height:460px;object-fit:cover}
  .news-content{color:#3a4a4d;font-size:1.05rem;line-height:1.85}.news-content h2,.news-content h3{color:var(--colorVar3);margin:2rem 0 .8rem}.news-content p{margin:1rem 0}.news-content ul{margin:1rem 0 1rem 1.4rem}.news-content a{color:var(--colorVar2);font-weight:700}.news-content img{max-width:100%;border-radius:16px}
  @media(max-width:980px){.news-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:768px){.news-hero{min-height:420px;align-items:flex-end}.hero-content{padding:120px 0 110px}.news-grid{grid-template-columns:1fr;width:min(92vw,540px);margin:0 auto}.news-main{padding-top:3.5rem}}
</style>

<script>
  const listEl = document.getElementById('news-list');
  const detailEl = document.getElementById('news-detail');
  const detailBody = document.getElementById('news-detail-body');
  const slug = new URLSearchParams(location.search).get('a');
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const fmtDate = (d) => d ? new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '';

  async function showList() {
    try {
      const r = await fetch('/api/public/articles');
      if (!r.ok) throw new Error();
      const articles = await r.json();
      if (!articles.length) {
        listEl.innerHTML = '<p class="news-status">Aucune actualité pour le moment — revenez bientôt.</p>';
        return;
      }
      listEl.innerHTML = articles.map((a) => `
        <a class="news-card" href="/actualites/?a=${encodeURIComponent(a.slug)}">
          ${a.imageUrl ? `<div class="news-card-img"><img src="${esc(a.imageUrl)}" alt="" loading="lazy" /></div>` : ''}
          <div class="news-card-body">
            <span class="news-date">${fmtDate(a.publishedAt || a.createdAt)}</span>
            <h2>${esc(a.title)}</h2>
            ${a.summary ? `<p>${esc(a.summary)}</p>` : ''}
            <span class="news-more">Lire l’article →</span>
          </div>
        </a>`).join('');
    } catch {
      listEl.innerHTML = '<p class="news-status">Impossible de charger les actualités pour le moment.</p>';
    }
  }

  async function showDetail() {
    listEl.hidden = true;
    detailEl.hidden = false;
    try {
      const r = await fetch(`/api/public/articles/${encodeURIComponent(slug)}`);
      if (!r.ok) throw new Error();
      const a = await r.json();
      document.title = `${a.title} — Pradel Élagage`;
      detailBody.innerHTML = `
        <h1>${esc(a.title)}</h1>
        <p class="news-date">${fmtDate(a.publishedAt || a.createdAt)}</p>
        ${a.imageUrl ? `<div class="news-detail-hero"><img src="${esc(a.imageUrl)}" alt="" /></div>` : ''}
        <div class="news-content">${a.content || (a.summary ? `<p>${esc(a.summary)}</p>` : '')}</div>`;
    } catch {
      detailBody.innerHTML = '<p class="news-status">Article introuvable. <a href="/actualites/">Retour aux actualités</a></p>';
    }
  }

  if (slug) showDetail(); else showList();
</script>
