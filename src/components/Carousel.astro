---
export interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props as Props;
---

<section class="swiper mySwiper" aria-label="Galerie d’images" aria-roledescription="carrousel">
  <div class="swiper-wrapper">
    {images.map((img, index) => (
      <div class="swiper-slide" role="group" aria-label={`Image ${index + 1} sur ${images.length}`}>
        <img src={img.src} alt={img.alt} loading="lazy" />
      </div>
    ))}
  </div>
</section>

<style>
  .swiper {
    width: 35vw;
    height: 25vw;
    border-radius: 20px;
    box-shadow:
      inset 0 0 0.5px 1px hsla(0, 0%, 100%, 0.075),
      0 0 0 1px hsla(0, 0%, 0%, 0.05),
      0 0.3px 0.4px hsla(0, 0%, 0%, 0.02),
      0 0.9px 1.5px hsla(0, 0%, 0%, 0.045),
      0 3.5px 6px hsla(0, 0%, 0%, 0.09);
    background: linear-gradient(to right, #ffffff, #ece9e6);
  }

  .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.swiper-wrapper) { transition-duration: 0.01ms !important; }
  }

  @media (max-width: 768px) {
    .swiper {
      width: 90vw;
      height: 55vw;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay } from 'swiper/modules';
  import 'swiper/css';

  function initialiseCarousels() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.mySwiper:not([data-initialised])').forEach((element) => {
      element.dataset.initialised = 'true';
      new Swiper(element, {
        modules: [Autoplay],
        loop: true,
        spaceBetween: 0,
        centeredSlides: true,
        autoplay: reduceMotion ? false : { delay: 3000, disableOnInteraction: false, pauseOnMouseEnter: true },
      });
    });
  }

  document.addEventListener('astro:page-load', initialiseCarousels);
</script>
