---
// Bannière de consentement cookies (repris du thème WP teddy-elagage)
---

<div id="privacy-banner" class="privacy-banner" data-privacy-banner hidden role="region" aria-labelledby="privacy-title">
  <div class="privacy-content">
    <div class="privacy-copy">
      <h2 id="privacy-title">Vos préférences de confidentialité</h2>
      <p>
        Nous utilisons le stockage local pour mémoriser votre choix. La carte OpenStreetMap est chargée directement pour afficher notre localisation.
        <a href="/mentions-legales/#confidentialite">En savoir plus</a>
      </p>
    </div>
    <div class="privacy-actions">
      <button class="privacy-refuse" type="button" data-privacy-choice="refused">Tout refuser</button>
      <button class="privacy-accept" type="button" data-privacy-choice="accepted">Tout accepter</button>
    </div>
  </div>
</div>
<p id="privacy-status" class="visually-hidden" role="status" aria-live="polite"></p>

<script>
  type PrivacyChoice = 'accepted' | 'refused';
  const privacyKey = 'privacyPreference';

  function getPrivacyChoice(): PrivacyChoice | null {
    const value = localStorage.getItem(privacyKey);
    return value === 'accepted' || value === 'refused' ? value : null;
  }

  function showPrivacyBanner(moveFocus = false) {
    const banner = document.querySelector<HTMLElement>('[data-privacy-banner]');
    if (!banner) return;
    banner.hidden = false;
    if (moveFocus) banner.querySelector<HTMLButtonElement>('[data-privacy-choice]')?.focus();
  }

  function hidePrivacyBanner() {
    const banner = document.querySelector<HTMLElement>('[data-privacy-banner]');
    if (banner) banner.hidden = true;
  }

  function savePrivacyChoice(choice: PrivacyChoice) {
    localStorage.setItem(privacyKey, choice);
    hidePrivacyBanner();
    const status = document.getElementById('privacy-status');
    if (status) status.textContent = choice === 'accepted'
      ? 'Les services facultatifs sont acceptés.'
      : 'Les services facultatifs sont refusés.';
    window.dispatchEvent(new CustomEvent('privacy-preference-change', { detail: choice }));
    document.querySelector<HTMLButtonElement>('[data-open-privacy]')?.focus();
  }

  function initializePrivacyBanner() {
    const banner = document.querySelector<HTMLElement>('[data-privacy-banner]');
    if (!banner) return;
    if (!getPrivacyChoice()) showPrivacyBanner();

    if (document.documentElement.dataset.privacyInitialized === 'true') return;
    document.documentElement.dataset.privacyInitialized = 'true';

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const choiceButton = event.target.closest<HTMLElement>('[data-privacy-choice]');
      const choice = choiceButton?.dataset.privacyChoice;
      if (choice === 'accepted' || choice === 'refused') savePrivacyChoice(choice);
      if (event.target.closest('[data-open-privacy]')) showPrivacyBanner(true);
    });
  }

  document.addEventListener('astro:page-load', initializePrivacyBanner);
  initializePrivacyBanner();
</script>

<style>
  .privacy-banner {
    position: fixed;
    z-index: 600000;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 24px;
    background: rgba(184, 204, 176, 0.96);
    box-shadow: 0 20px 55px rgba(29, 52, 58, 0.28);
    backdrop-filter: blur(12px) saturate(115%);
    -webkit-backdrop-filter: blur(12px) saturate(115%);
  }

  .privacy-banner[hidden] {
    display: none;
  }

  .privacy-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .privacy-copy {
    max-width: 760px;
  }

  .privacy-copy h2 {
    margin-bottom: 0.3rem;
    color: var(--colorVar3);
    font-size: 1.55rem;
  }

  .privacy-copy p {
    color: #344e50;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .privacy-copy a {
    color: var(--colorVar3);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .privacy-actions {
    display: flex;
    flex: none;
    gap: 0.75rem;
  }

  .privacy-actions button {
    min-height: 48px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--colorVar3);
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 800;
    white-space: nowrap;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .privacy-actions button:hover,
  .privacy-actions button:focus-visible {
    transform: translateY(-2px);
  }

  .privacy-refuse {
    color: var(--colorVar3);
    background: rgba(255, 255, 255, 0.45);
  }

  .privacy-refuse:hover,
  .privacy-refuse:focus-visible,
  .privacy-accept {
    color: #fff;
    background: var(--colorVar3);
  }

  .privacy-accept:hover,
  .privacy-accept:focus-visible {
    background: var(--colorVar2);
    border-color: var(--colorVar2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .privacy-banner {
      right: 0.6rem;
      bottom: 0.6rem;
      left: 0.6rem;
      border-radius: 20px;
    }

    .privacy-content {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .privacy-actions {
      flex-direction: column-reverse;
    }

    .privacy-actions button {
      width: 100%;
    }
  }
</style>
