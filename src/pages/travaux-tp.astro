---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Carousel from '../components/Carousel.astro';
import InfoCards from '../components/InfoCards.astro';

const title = 'Travaux TP à Thiers (63300) — Pradel Elagage | Terrassement et défrichage';
const description = 'Travaux TP à Thiers par Pradel Elagage : terrassement, défrichage, préparation de terrain, aménagement extérieur. Matériel professionnel pour vos projets. Devis gratuit.';

// TODO: remplacer par les images réelles des travaux TP
const carouselImages = [
  { src: '/img/un-camion.webp', alt: 'Travaux TP Thiers — camion' },
  { src: '/img/foret.png', alt: 'Défrichage Thiers — préparation terrain' },
  { src: '/img/arbre.png', alt: 'Terrassement Thiers — travaux' },
];

const infoCards = [
  {
    image: '/img/un-camion.webp',
    imageAlt: 'Terrassement Thiers',
    title: 'TERRASSEMENT',
    text: 'Travaux de terrassement pour préparer votre terrain : nivellement, excavation, déblai-remblai.',
  },
  {
    image: '/img/arbreRelou.webp',
    imageAlt: 'Défrichage Thiers',
    title: 'DÉFRICHAGE',
    text: 'Défrichage et débroussaillage pour nettoyer et préparer votre terrain à l\'aménagement.',
  },
  {
    image: '/img/chainsaw.webp',
    imageAlt: 'Broyage Thiers',
    title: 'BROYAGE',
    text: 'Broyage de végétaux et branches pour valoriser les déchets verts et nettoyer votre terrain.',
  },
  {
    image: '/img/foret.png',
    imageAlt: 'Aménagement extérieur Thiers',
    title: 'AMÉNAGEMENT',
    text: 'Aménagement de vos espaces extérieurs : préparation de terrain, accès, chemins et plus encore.',
  },
];
---

<MainLayout title={title} description={description} footerVariant="page">
  <PageHero
    image="/img/un-camion.webp"
    imageAlt="Travaux TP Thiers 63300 — Pradel Elagage"
    title="TRAVAUX TP"
  />

  <article class="post">
    <div class="containerSinglePage">
      <Carousel images={carouselImages} />

      <div class="paragrapheSingle animated-element">
        <p>
          Des <strong>travaux de terrassement</strong> et <strong>TP</strong>
          réalisés avec un matériel professionnel 🚜 pour vos projets
          d'aménagement, de défrichage et de préparation de terrain.
        </p>
        <p>
          Interventions sur Thiers, le Forez et la montagne Thiernoise ⛰️.
          <strong>Devis gratuit</strong> sur demande.
        </p>
      </div>
    </div>
  </article>

  <InfoCards cards={infoCards} />
</MainLayout>

<style>
  .containerSinglePage {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-direction: row;
    transform: translateY(-44vh);
  }

  .paragrapheSingle {
    display: flex;
    flex-direction: column;
    width: 50%;
    height: auto;
    align-items: center;
    margin-right: 4vw;
  }

  .paragrapheSingle :global(p) {
    margin-bottom: 3vh;
    font-size: 1.2vw;
    text-align: center;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .containerSinglePage {
      flex-direction: column;
      transform: translateY(0);
    }

    .paragrapheSingle {
      width: 100%;
      height: auto;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .paragrapheSingle :global(p) {
      width: 100%;
      height: auto;
      font-size: 5vw;
      padding: 2vh;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('.animated-element');
    animatedElements.forEach((el) => el.classList.add('animate'));
  });

  document.addEventListener('scroll', () => {
    const animatedElements2 = document.querySelectorAll('.animated-element-2');
    const windowHeight = window.innerHeight;

    animatedElements2.forEach((el) => {
      const elementOffset = el.getBoundingClientRect().top;
      if (elementOffset < windowHeight * 1) {
        el.classList.add('animate');
      }
    });
  });
</script>
