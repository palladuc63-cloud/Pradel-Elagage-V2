---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Carousel from '../components/Carousel.astro';
import InfoCards from '../components/InfoCards.astro';

const title = 'Bois de chauffage à Thiers (63300) — Pradel Elagage | Vente et livraison';
const description = 'Vente et livraison de bois de chauffage 100% feuillus à Thiers. Dimensions 25, 33, 40, 50 cm. Livraison de 5 stères sur Thiers et la montagne Thiernoise. Bois de qualité supérieure.';

// TODO: remplacer par les images réelles depuis la BDD (champs ACF imgcarrouselbois-a, etc.)
const carouselImages = [
  { src: '/img/bois-de-chauffage.webp', alt: 'Bois de chauffage Thiers' },
  { src: '/img/wood.webp', alt: 'Bois de chauffage 100% feuillus Thiers' },
  { src: '/img/bois-de-chauffage.png', alt: 'Livraison bois de chauffage Thiers' },
];

// TODO: remplacer par les contenus réels depuis la BDD (champs ACF imgessences, titreessence, etc.)
const infoCards = [
  {
    image: '/img/wood.webp',
    imageAlt: 'Essences de bois Thiers',
    title: 'ESSENCES',
    text: 'Bois de chauffage 100% feuillus. Chêne, hêtre et autres essences de qualité pour un chauffage efficace et durable.',
  },
  {
    image: '/img/bois-de-chauffage.webp',
    imageAlt: 'Dimensions bois de chauffage Thiers',
    title: 'DIMENSIONS',
    text: 'Dimensions disponibles : 25, 33, 40 et 50 cm pour s\'adapter à tous les types de foyers et de poêles.',
  },
  {
    image: '/img/un-camion.webp',
    imageAlt: 'Livraison bois de chauffage Thiers',
    title: 'LIVRAISON',
    text: 'Livraison de 5 stères minimum sur Thiers et la montagne Thiernoise. Service rapide et fiable.',
  },
];
---

<MainLayout title={title} description={description} footerVariant="page">
  <PageHero
    image="/img/bois-de-chauffage.webp"
    imageAlt="Bois de chauffage Thiers 63300 — Pradel Elagage"
    title="BOIS DE CHAUFFAGE"
  />

  <article class="post">
    <div class="containerSinglePage">
      <Carousel images={carouselImages} />

      <div class="paragrapheSingle animated-element">
        <p>
          Je suis fier de vous fournir 💁 un <strong>approvisionnement en bois
          de chauffage 🪵 de qualité supérieure</strong> pour répondre à vos
          besoins hivernaux ⛄.
        </p>
        <p>
          <strong>100% feuillus</strong> 🌳, mes dimensions : 25, 33, 40, 50 cm,
          en livraison 🚚 de 5 stères et sur la zone de Thiers et de la
          montagne Thiernoise ⛰️.
        </p>
      </div>
    </div>
  </article>

  <InfoCards cards={infoCards} />
</MainLayout>

<style>
  .containerSinglePage {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-direction: row;
    transform: translateY(-44vh);
  }

  .paragrapheSingle {
    display: flex;
    flex-direction: column;
    width: 50%;
    height: auto;
    align-items: center;
    margin-right: 4vw;
  }

  .paragrapheSingle :global(p) {
    margin-bottom: 3vh;
    font-size: 1.2vw;
    text-align: center;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .containerSinglePage {
      flex-direction: column;
      transform: translateY(0);
    }

    .paragrapheSingle {
      width: 100%;
      height: auto;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .paragrapheSingle :global(p) {
      width: 100%;
      height: auto;
      font-size: 5vw;
      padding: 2vh;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('.animated-element');
    animatedElements.forEach((el) => el.classList.add('animate'));
  });

  document.addEventListener('scroll', () => {
    const animatedElements2 = document.querySelectorAll('.animated-element-2');
    const windowHeight = window.innerHeight;

    animatedElements2.forEach((el) => {
      const elementOffset = el.getBoundingClientRect().top;
      if (elementOffset < windowHeight * 1) {
        el.classList.add('animate');
      }
    });
  });
</script>
