---
import { homeSlides } from '../data/site.js';
---

<div class="sliderHome">
  <div class="swiper-container swiper">
    <div class="swiper-wrapper">
      {homeSlides.map((slide) => (
        <div class="swiper-slide">
          <img src={slide.image} alt={slide.alt} loading="lazy" />
          <div class="slide-content" set:html={slide.text} />
          <a href={slide.link} class="btn-pradel slide-btn">{slide.linkLabel}</a>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .sliderHome {
    position: relative;
    top: -20vh;
    right: 0;
    overflow: hidden;
  }

  .swiper-container {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    position: relative;
  }

  .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-content {
    width: 21%;
    height: auto;
    transform: translateY(-60vh);
    background: linear-gradient(to right, #ffffff, #ece9e6);
    border-radius: 20px;
    margin-left: 12vw;
    text-align: center;
    display: flex;
    align-items: center;
    flex-direction: column;
    opacity: 0;
    transform: translateY(0);
    transition: opacity 2s ease, transform 1s ease;
    box-shadow:
      inset 0 0 0.5px 1px hsla(0, 0%, 100%, 0.075),
      0 0 0 1px hsla(0, 0%, 0%, 0.05),
      0 0.3px 0.4px hsla(0, 0%, 0%, 0.02),
      0 0.9px 1.5px hsla(0, 0%, 0%, 0.045),
      0 3.5px 6px hsla(0, 0%, 0%, 0.09);
  }

  .slide-content :global(h1) {
    width: 100%;
    height: auto;
    padding: 1vh;
    margin-top: 1.5vh;
  }

  .slide-content :global(p) {
    width: 85%;
    height: auto;
    margin-top: 1vh;
    margin-bottom: 2vh;
    font-size: 1vw;
    line-height: 1.5;
  }

  .slide-btn {
    width: 45%;
    height: 6vh;
    margin-bottom: 5vh;
    transform: translateY(0);
  }

  .active-slide-content {
    opacity: 0.9;
    transform: translateY(-60vh);
  }

  @media (max-width: 768px) {
    .swiper-container {
      width: 100%;
      height: 100vh;
    }

    .slide-content {
      width: 70%;
      margin-left: 15vw;
    }

    .slide-content :global(p) {
      font-size: 4.5vw;
    }

    .slide-content :global(h1) {
      font-size: 8vw;
    }

    .slide-btn {
      padding: 1vh;
      font-size: 4vw;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination, Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/navigation';

  document.addEventListener('astro:page-load', () => {
    const swiperContainer = document.querySelector<HTMLElement>('.swiper-container');
    if (!swiperContainer || swiperContainer.dataset.initialised === 'true') return;
    swiperContainer.dataset.initialised = 'true';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const swiper = new Swiper(swiperContainer, {
      modules: [Autoplay, Pagination, Navigation],
      loop: true,
      autoplay: reduceMotion ? false : {
        delay: 6000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      on: {
        slideChange: (currentSwiper) => {
          const slideContents = document.querySelectorAll('.slide-content');
          slideContents.forEach((content) => content.classList.remove('active-slide-content'));

          const activeSlide = currentSwiper.slides[currentSwiper.activeIndex];
          const activeContent = activeSlide?.querySelector('.slide-content');
          if (activeContent) {
            activeContent.classList.add('active-slide-content');
          }
        },
      },
    });

    // Active le premier slide au chargement
    const initialSlide = swiper.slides[0];
    const initialContent = initialSlide?.querySelector('.slide-content');
    initialContent?.classList.add('active-slide-content');

    // Pause au survol
    swiperContainer.addEventListener('mouseenter', () => swiper.autoplay.stop());
    swiperContainer.addEventListener('mouseleave', () => swiper.autoplay.start());
  });
</script>
