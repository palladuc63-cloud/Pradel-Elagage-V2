---
import { homeSlides } from '../data/site.js';
---

<section class="hero-slider" aria-label="Activités de Pradel Élagage">
  <div class="hero-swiper swiper">
    <div class="swiper-wrapper">
      {homeSlides.map((slide, index) => (
        <article class={`swiper-slide hero-slide hero-slide-${index + 1}`}>
          <img
            class="hero-image"
            src={slide.image}
            alt={slide.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
          <div class="hero-shade"></div>
          <div class={`hero-layout hero-layout-${index % 2 === 0 ? 'left' : 'right'}`}>
            <div class="hero-card">
              <p class="hero-eyebrow">{slide.eyebrow}</p>
              <h1>{slide.title}</h1>
              <p class="hero-description">{slide.description}</p>
              <div class="hero-actions">
                <a class="hero-button hero-button-primary" href={slide.link}>{slide.linkLabel}</a>
                <a class="hero-button hero-button-secondary" href="/contact/">Demander un devis</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="hero-pagination swiper-pagination" aria-label="Choisir une activité"></div>
    <p class="sr-only hero-status" aria-live="polite"></p>
  </div>
</section>

<style>
  .hero-slider {
    position: relative;
    width: 100%;
    height: clamp(700px, 88vh, 980px);
    overflow: hidden;
    background: transparent;
  }

  .hero-swiper,
  .swiper-wrapper,
  .hero-slide {
    width: 100%;
    height: 100%;
  }

  .hero-slide {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mask-image: linear-gradient(to bottom, #000 0%, #000 85%, transparent 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 85%, transparent 95%, transparent 100%);
    transform: scale(1.04);
    transition: transform 4.8s ease;
  }

  .swiper-slide-active .hero-image {
    transform: scale(1);
  }

  .hero-slide-1 .hero-image {
    object-position: center 44%;
  }

  .hero-slide-2 .hero-image {
    object-position: center 55%;
  }

  .hero-slide-3 .hero-image {
    object-position: center;
    transform: scale(1.04) scaleX(-1);
  }

  .swiper-slide-active.hero-slide-3 .hero-image {
    transform: scale(1) scaleX(-1);
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(16, 35, 39, 0.04) 0%, rgba(16, 35, 39, 0.13) 68%, rgba(16, 35, 39, 0.34) 100%),
      linear-gradient(90deg, rgba(16, 35, 39, 0.17), transparent 52%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 85%, transparent 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 85%, transparent 95%, transparent 100%);
  }

  .hero-layout {
    display: flex;
    align-items: center;
    width: min(1420px, 88vw);
    height: 100%;
    margin: 0 auto;
    padding-top: 130px;
    padding-bottom: 72px;
  }

  .hero-layout-left {
    justify-content: flex-start;
  }

  .hero-layout-right {
    justify-content: flex-end;
  }

  .hero-card {
    width: min(530px, 43vw);
    padding: clamp(2rem, 3vw, 3.25rem);
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 24px 70px rgba(16, 35, 39, 0.22);
    backdrop-filter: blur(15px) saturate(125%);
    -webkit-backdrop-filter: blur(15px) saturate(125%);
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 600ms ease 180ms, transform 700ms ease 180ms;
  }

  .swiper-slide-active .hero-card {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-eyebrow {
    margin-bottom: 0.7rem;
    color: var(--colorVar2);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-card h1 {
    max-width: 12ch;
    color: var(--colorVar3);
    font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 47ch;
    margin-top: 1.35rem;
    color: #26383b;
    font-size: clamp(1rem, 1.18vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0.75rem 1.15rem;
    border: 2px solid var(--colorVar2);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    text-align: center;
    transition: color 200ms ease, background 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .hero-button:hover,
  .hero-button:focus-visible {
    transform: translateY(-2px);
  }

  .hero-button-primary {
    color: #fff;
    background: var(--colorVar2);
    box-shadow: 0 9px 24px rgba(57, 136, 123, 0.26);
  }

  .hero-button-primary:hover,
  .hero-button-primary:focus-visible {
    background: var(--colorVar3);
    border-color: var(--colorVar3);
  }

  .hero-button-secondary {
    color: var(--colorVar3);
    background: rgba(255, 255, 255, 0.52);
  }

  .hero-button-secondary:hover,
  .hero-button-secondary:focus-visible {
    color: #fff;
    background: var(--colorVar3);
    border-color: var(--colorVar3);
  }

  :global(.hero-pagination.swiper-pagination) {
    right: auto;
    bottom: 28px;
    left: 50%;
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    width: auto;
    transform: translateX(-50%);
  }

  :global(.hero-pagination .swiper-pagination-bullet) {
    width: 10px;
    height: 10px;
    margin: 0 !important;
    border: 2px solid rgba(255, 255, 255, 0.92);
    background: transparent;
    opacity: 0.72;
    transition: width 220ms ease, opacity 220ms ease, background 220ms ease;
  }

  :global(.hero-pagination .swiper-pagination-bullet-active) {
    width: 34px;
    border-radius: 999px;
    background: #fff;
    opacity: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .hero-slider {
      height: 100svh;
      min-height: 680px;
    }

    .hero-layout {
      align-items: flex-end;
      width: 90vw;
      padding: 145px 0 76px;
    }

    .hero-layout-left,
    .hero-layout-right {
      justify-content: center;
    }

    .hero-card {
      width: 100%;
      padding: 1.6rem;
      border-radius: 22px;
    }

    .hero-card h1 {
      font-size: clamp(2.6rem, 13vw, 4.2rem);
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-button {
      width: 100%;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, EffectFade, Keyboard, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-fade';
  import 'swiper/css/pagination';

  function initializeHeroSlider() {
    const slider = document.querySelector<HTMLElement>('.hero-swiper');
    if (!slider || slider.dataset.initialized === 'true') return;
    slider.dataset.initialized = 'true';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const status = slider.querySelector<HTMLElement>('.hero-status');
    const slideCount = slider.querySelectorAll('.hero-slide').length;

    const swiper = new Swiper(slider, {
      modules: [Autoplay, EffectFade, Keyboard, Pagination],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      speed: reduceMotion ? 0 : 650,
      loop: !reduceMotion,
      allowTouchMove: true,
      autoplay: reduceMotion ? false : {
        delay: 4000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      pagination: {
        el: '.hero-pagination',
        clickable: true,
        renderBullet: (index, className) => `<button class="${className}" type="button" aria-label="Afficher l’activité ${index + 1} sur ${slideCount}"></button>`,
      },
      keyboard: {
        enabled: true,
      },
      on: {
        slideChange: (currentSwiper) => {
          if (status) status.textContent = `Activité ${currentSwiper.realIndex + 1} sur ${slideCount}`;
        },
      },
    });

    // Pause pendant l’utilisation des liens du slide
    slider.addEventListener('focusin', () => swiper.autoplay?.stop());
    slider.addEventListener('focusout', () => {
      if (!reduceMotion) swiper.autoplay?.start();
    });
  }

  document.addEventListener('astro:page-load', initializeHeroSlider);
  initializeHeroSlider();
</script>
