---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site.js';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/img/LogoTeddyV2.webp',
  noindex = false,
} = Astro.props;

const publicSiteUrl = Astro.site ?? new URL(site.url);
const basePath = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, publicSiteUrl).href;
const ogImage = new URL(`${basePath}${image.replace(/^\//, '')}`, publicSiteUrl).href;

// Données structurées JSON-LD (LocalBusiness) pour le SEO local
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  image: new URL(`${basePath}img/LogoTeddyV2.webp`, publicSiteUrl).href,
  url: publicSiteUrl.href,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  areaServed: 'Thiers, Montagne Thiernoise, Puy-de-Dôme',
  description: site.description,
  priceRange: '€€',
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={site.themeColor} />

    {/* SEO */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    {/* Favicon */}
    <link rel="icon" href={`${basePath}favicon.ico`} />

    {/* Polices auto-hébergées : préchargement du subset latin (body text) */}
    <link rel="preload" href={`${basePath}fonts/open-sans-latin.woff2`} as="font" type="font/woff2" crossorigin />

    {/* Données structurées LocalBusiness */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Transitions de page fluides */}
    <ClientRouter />

    {/* Mesure d'audience anonyme (Umami auto-hébergé, sans cookie) */}
    <script is:inline defer src="https://stats.agencepoint.fr/script.js" data-website-id="b4ddc933-8522-4840-be0f-f3db230d4209" data-host-url="https://stats.agencepoint.fr" data-do-not-track="true"></script>

    {/* Events métier → Umami (appel, email, whatsapp, formulaires) */}
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a || !(window.umami && umami.track)) return;
        var h = a.getAttribute('href') || '';
        var ev = h.indexOf('tel:') === 0 ? 'appel' : h.indexOf('mailto:') === 0 ? 'email' : /wa\.me|whatsapp/i.test(h) ? 'whatsapp' : null;
        if (ev) umami.track(ev, { page: location.pathname });
      }, true);
      document.addEventListener('submit', function () {
        if (!(window.umami && umami.track)) return;
        var p = location.pathname;
        var ev = /commande/.test(p) ? 'commande' : /devis/.test(p) ? 'devis' : /contact/.test(p) ? 'contact' : 'form_submit';
        umami.track(ev, { page: p });
      }, true);
    </script>

    {/* Web Vitals réels utilisateurs → events Umami (vitals-lcp/cls/fid/ttfb) */}
    <script is:inline>
      (function () {
        if (!('PerformanceObserver' in window)) return;
        const q = [];
        const flush = () => {
          if (!(window.umami && umami.track)) return false;
          for (const [n, v] of q.splice(0)) umami.track('vitals-' + n, { value: Math.round(v), page: location.pathname });
          return true;
        };
        const send = (n, v) => {
          q.push([n, v]);
          if (!flush()) {
            const iv = setInterval(() => flush() && clearInterval(iv), 1000);
            setTimeout(() => clearInterval(iv), 15000);
          }
        };
        try { new PerformanceObserver((l) => { const e = l.getEntries().pop(); e && send('lcp', e.startTime); }).observe({ type: 'largest-contentful-paint', buffered: true }); } catch {}
        try { let cls = 0, sent = false; new PerformanceObserver((l) => { for (const e of l.getEntries()) if (!e.hadRecentInput) cls += e.value; if (!sent) { sent = true; send('cls', cls * 1000); } }).observe({ type: 'layout-shift', buffered: true }); } catch {}
        try { new PerformanceObserver((l) => { const e = l.getEntries().pop(); e && send('fid', e.processingStart - e.startTime); }).observe({ type: 'first-input', buffered: true }); } catch {}
        addEventListener('load', () => { const nav = performance.getEntriesByType('navigation')[0]; nav && send('ttfb', nav.responseStart); });
      })();
    </script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <filter id="grain-overlay" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" result="noise" />
          <feColorMatrix in="noise" type="saturate" values="0" result="grey" />
          <feComponentTransfer in="grey" result="faded">
            <feFuncA type="linear" slope="0.35" intercept="0" />
          </feComponentTransfer>
          <feComposite in="faded" in2="SourceAlpha" operator="in" result="clipped" />
          <feMerge>
            <feMergeNode in="SourceGraphic" />
            <feMergeNode in="clipped" />
          </feMerge>
        </filter>
      </defs>
    </svg>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <script is:inline>
      document.addEventListener('mousedown', (e) => {
        if (e.button === 0) document.documentElement.dataset.cursor = 'strike';
      });
      document.addEventListener('mouseup', () => {
        document.documentElement.dataset.cursor = 'rebound';
        setTimeout(() => { delete document.documentElement.dataset.cursor; }, 140);
      });
    </script>
    <script is:inline>
      /* Reveal au scroll — mobile uniquement (≤768px), désactivé si motion réduite */
      function initScrollReveal() {
        const main = document.getElementById('main-content');
        if (!main) return;
        if (!window.matchMedia('(max-width: 768px)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('reveal-armed');

        const CANDIDATES = [
          'h1', 'h2', 'h3', 'h4', 'p', 'ul', 'ol', 'figure', 'img', 'form', 'address',
          '.section-heading', '.hero-content', '.hero-actions', '.contact-intro',
          '.contact-method', '.service-card', '.tp-service-card', '.tree-service-card',
          '.size-card', '.news-grid', '.assurance-item', '.form-card', '.form-heading',
          '.final-actions', '.final-cta', '.area-content', '.aside-image', '.aside-content',
          '.delivery-content', '.expertise-copy', '.expertise-points', '.project-copy',
          '.project-image', '.quality-copy', '.openstreet-map', '.swiper',
          '[class*="slider"]', '.steps', '.historical-card-shape',
        ].join(',');
        const SKIP = 'header, footer, nav, #menu, .hero-curve, [data-map-trees], .swiper-slide, .sr-only, .pradel-popup';
        const ZOOM = 'IMG, FIGURE, .project-image, .aside-image';

        const marked = [];
        main.querySelectorAll(CANDIDATES).forEach((el) => {
          if (el.closest(SKIP) || el.closest('[data-reveal]')) return;
          el.setAttribute('data-reveal', el.matches(ZOOM) ? 'zoom' : 'up');
          marked.push(el);
        });

        marked.forEach((el) => {
          let i = 0;
          for (const sib of el.parentElement.children) {
            if (sib === el) break;
            if (sib.hasAttribute('data-reveal')) i++;
          }
          if (i) el.style.setProperty('--reveal-delay', Math.min(i, 5) * 70 + 'ms');
        });

        const io = (window.__revealIO ||= new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            window.__revealIO.unobserve(entry.target);
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' }));
        marked.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initScrollReveal);
      initScrollReveal();
    </script>
  </body>
</html>
